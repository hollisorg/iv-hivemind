{
  "name": "iv-hivemind",
  "productName": "IV Hivemind",
  "version": "0.7.4",
  "description": "The desktop overlay for IV Outreach, IV Studio, IV Signal, IV Chat, IV Voice and IV Downloader.",
  "author": "The Hollis Organization",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hollisorg/iv-hivemind.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "node --test --test-concurrency=1 \"test/*.test.mjs\"",
    "dist": "electron-vite build && electron-builder --win --x64 --publish never",
    "dist:win-release": "node scripts/windows-release.cjs",
    "dist:dir": "electron-vite build && electron-builder --win --x64 --dir --publish never",
    "check:shared": "node scripts/check-shared.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "electron-updater": "6.8.11",
    "electron-vite": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "org.hollis.hivemind",
    "electronVersion": "44.9.1",
    "files": ["out/**/*", "package.json"],
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "publish": [{ "provider": "github", "owner": "hollisorg", "repo": "iv-hivemind-releases", "releaseType": "release" }],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "IV-Hivemind-Setup.exe",
      "shortcutName": "IV Hivemind"
    }
  }
}
